using Gtk 4.0;
using Adw 1;

// Memory page: usage graph, then used, available, cache and swap.
template $CwMemoryPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1000;

      child: Box {
        orientation: vertical;
        spacing: 18;

        styles [
          "cw-page",
        ]

        $CwGraph graph {
          height-request: 160;
        }

        Adw.PreferencesGroup {
          Adw.ActionRow used {
            title: "Used";
            subtitle: "…";
          }

          Adw.ActionRow available {
            title: "Available";
            subtitle: "…";
          }

          Adw.ActionRow cached {
            title: "Cache and buffers";
            subtitle: "…";
          }

          Adw.ActionRow swap {
            title: "Swap";
            subtitle: "…";

            [suffix]
            LevelBar swap_bar {
              width-request: 120;
              valign: center;
            }
          }

          // Hidden on kernels without pressure information.
          Adw.ActionRow pressure {
            title: "Pressure";
            subtitle: "…";
            visible: false;
          }
        }
      };
    };
  };
}
