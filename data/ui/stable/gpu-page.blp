using Gtk 4.0;
using Adw 1;

translation-domain "corewatch";

// GPU page. Displays aggregate and per-GPU usage graph, clock speed, VRAM, and temperature.
template $CwGpuPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1000;

      child: Box {
        orientation: vertical;
        spacing: 18;

        styles [
          "cw-page",
        ]

        $CwGraph graph {
          height-request: 160;
        }

        Adw.PreferencesGroup info_group {
          title: _("Graphics Card");

          Adw.ActionRow model {
            title: _("Model");
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow driver {
            title: _("Driver");
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow usage_row {
            title: _("Core Usage");
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow freq {
            title: _("Clock Speed");
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow vram {
            title: _("Memory (VRAM)");
            subtitle: "…";
            subtitle-selectable: true;

            [suffix]
            LevelBar vram_bar {
              width-request: 120;
              valign: center;
              visible: false;
            }
          }

          Adw.ActionRow temp {
            title: _("Temperature");
            subtitle: "…";
            subtitle-selectable: true;
          }
        }

        // Sensors that belong to this page; filled by widgets::SensorGroup.
        Adw.PreferencesGroup sensors_group {
          title: _("Sensors");
          visible: false;
        }
      };
    };
  };
}
