using Gtk 4.0;
using Adw 1;

translation-domain "corewatch";

// GPU page. One block per graphics card is added to gpus_box at run time:
// heading, load graph and the values its driver reports.
template $CwGpuPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1000;

      child: Box {
        orientation: vertical;
        spacing: 18;

        styles [
          "cw-page",
        ]

        Box gpus_box {
          orientation: vertical;
          spacing: 24;
        }

        // Sensors that belong to this page; filled by widgets::SensorGroup.
        Adw.PreferencesGroup sensors_group {
          title: _("Sensors");
          visible: false;
        }
      };
    };
  };
}
