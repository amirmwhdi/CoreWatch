using Gtk 4.0;
using Adw 1;

// Battery page. Displays battery level graph, status, remaining time, health, and power metrics.
template $CwBatteryPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1000;

      child: Box {
        orientation: vertical;
        spacing: 18;

        styles [
          "cw-page",
        ]

        $CwGraph graph {
          height-request: 160;
        }

        Adw.PreferencesGroup info_group {
          title: "Battery Details";

          Adw.ActionRow status_row {
            title: "Status";
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow level_row {
            title: "Charge Level";
            subtitle: "…";
            subtitle-selectable: true;

            [suffix]
            LevelBar level_bar {
              width-request: 120;
              valign: center;
            }
          }

          Adw.ActionRow time_row {
            title: "Time Remaining";
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow rate_row {
            title: "Charge / Discharge Rate";
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow health_row {
            title: "Health and Capacity";
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow power_supply_row {
            title: "AC Power Supply";
            subtitle: "…";
            subtitle-selectable: true;
          }

          Adw.ActionRow hardware_row {
            title: "Hardware";
            subtitle: "…";
            subtitle-selectable: true;
          }
        }

        // Sensors that belong to this page; filled by widgets::SensorGroup.
        Adw.PreferencesGroup sensors_group {
          title: "Sensors";
          visible: false;
        }
      };
    };
  };
}
