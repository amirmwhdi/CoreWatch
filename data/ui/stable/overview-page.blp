using Gtk 4.0;
using Adw 1;

translation-domain "corewatch";

// Overview page: one card per resource, filled in overview.rs. A card opens
// its resource's page.
template $CwOverviewPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1000;

      child: FlowBox cards {
        homogeneous: true;
        min-children-per-line: 1;
        max-children-per-line: 3;
        column-spacing: 12;
        row-spacing: 12;
        selection-mode: none;
        valign: start;

        styles [
          "cw-page",
        ]
      };
    };
  };
}
