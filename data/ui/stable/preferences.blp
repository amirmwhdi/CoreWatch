using Gtk 4.0;
using Adw 1;

template $CwPreferencesDialog: Adw.PreferencesDialog {
  title: "Preferences";

  Adw.PreferencesPage {
    title: "General";
    icon-name: "preferences-other-symbolic";

    Adw.PreferencesGroup {
      title: "Appearance";

      Adw.ComboRow theme_row {
        title: "Color Scheme";
        subtitle: "Choose light, dark, or follow system theme";
        model: Gtk.StringList {
          strings [
            "Follow System",
            "Light",
            "Dark",
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: "Startup";

      // Filled in preferences.rs: "Last Opened Page", then every page.
      Adw.ComboRow start_row {
        title: "Open On";
        subtitle: "The page shown when Corewatch starts";
      }
    }

    Adw.PreferencesGroup {
      title: "Monitoring";

      Adw.ComboRow interval_row {
        title: "Update Speed";
        subtitle: "How often graphs and statistics are sampled";
        model: Gtk.StringList {
          strings [
            "0.5 seconds",
            "1 second (Default)",
            "2 seconds (Power Saver)",
          ]
        };
      }

      Adw.ComboRow history_row {
        title: "Graph History";
        subtitle: "How far back graphs reach";
        model: Gtk.StringList {
          strings [
            "1 minute (Default)",
            "5 minutes",
            "15 minutes",
            "1 hour",
          ]
        };
      }

      Adw.SwitchRow smooth_row {
        title: "Smooth Graphs";
        subtitle: "Scroll graphs continuously between updates. Turn off to save power.";
      }
    }

    Adw.PreferencesGroup {
      title: "Alerts";
      description: "A notification when something needs attention";

      Adw.SwitchRow alerts_row {
        title: "Send Alerts";
      }

      Adw.SpinRow alert_temp_row {
        title: "Temperature Limit";
        subtitle: "Processor or graphics card, for 10 seconds";
        sensitive: bind alerts_row.active;
        adjustment: Gtk.Adjustment {
          lower: 50;
          upper: 230;
          step-increment: 1;
        };
      }

      Adw.SpinRow alert_memory_row {
        title: "Memory Limit (%)";
        subtitle: "Memory in use, for 30 seconds";
        sensitive: bind alerts_row.active;
        adjustment: Gtk.Adjustment {
          lower: 50;
          upper: 100;
          step-increment: 1;
        };
      }

      Adw.SpinRow alert_disk_row {
        title: "Disk Space Limit (%)";
        subtitle: "Space in use on a drive";
        sensitive: bind alerts_row.active;
        adjustment: Gtk.Adjustment {
          lower: 50;
          upper: 100;
          step-increment: 1;
        };
      }

      Adw.SwitchRow alert_busy_row {
        title: "Busy Processes";
        subtitle: "A process keeps a processor core busy for five minutes";
        sensitive: bind alerts_row.active;
      }

      Adw.SwitchRow background_row {
        title: "Keep Watching in the Background";
        subtitle: "Closing the window leaves Corewatch running to send alerts";
        sensitive: bind alerts_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: "Units";

      Adw.ComboRow temperature_row {
        title: "Temperature";
        model: Gtk.StringList {
          strings [
            "Celsius (°C)",
            "Fahrenheit (°F)",
          ]
        };
      }

      Adw.ComboRow sizes_row {
        title: "Sizes";
        model: Gtk.StringList {
          strings [
            "Binary",
            "Decimal",
          ]
        };
      }

      Adw.ComboRow network_row {
        title: "Network Speed";
        model: Gtk.StringList {
          strings [
            "Bytes per second (MB/s)",
            "Bits per second (Mb/s)",
          ]
        };
      }
    }
  }
}
