# Translations: one <lang>.po per language listed in LINGUAS, installed as
# <localedir>/<lang>/LC_MESSAGES/corewatch.mo.
# `meson compile corewatch-pot` refreshes po/corewatch.pot from the sources,
# `meson compile corewatch-update-po` merges it into every .po file.
i18n.gettext('corewatch', preset: 'glib')
