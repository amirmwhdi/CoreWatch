# Maintainer: Amirmahdi <https://github.com/amirmwhdi>
pkgname=corewatch
pkgver=0.3.0
pkgrel=1
pkgdesc='A modern system monitor for Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/amirmwhdi/CoreWatch'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'gcc-libs' 'glibc')
makedepends=('cargo' 'meson' 'blueprint-compiler')
# The release profile already strips the binary: no -debug package.
options=('!debug')
checkdepends=('appstream' 'desktop-file-utils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "CoreWatch-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "CoreWatch-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_NET_OFFLINE=true
  arch-meson . build
  meson compile -C build
}

check() {
  cd "CoreWatch-$pkgver"
  meson test -C build --print-errorlogs
}

package() {
  cd "CoreWatch-$pkgver"
  meson install -C build --destdir "$pkgdir"
}
